        "background": { "type": "string", "pattern": "^#[\\da-fA-F]{6}$" },
        "foreground": { "type": "string", "pattern": "^#[\\da-fA-F]{6}$" },
        "accent": { "type": "string", "pattern": "^#[\\da-fA-F]{6}$" },
