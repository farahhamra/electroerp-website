        "Thoughtful objects for the art of everyday living.",
        "Explore the shapes, materials and details that bring this fictional collection together."
      ],
      "cta": {
        "label": "Read our story",
        "href": "/story"
      },
      "style": {
        "tone": "surface",
        "spacing": "airy"
      }
    },
    {
      "id": "our-promises",
      "type": "benefits",
      "style": {
        "spacing": "compact"
      }
    },
    {
      "id": "good-to-know",
      "type": "faq",
      "title": "A few helpful details.",
      "items": [
        {
          "question": "Can I place a real order here?",
          "answer": "This is a fictional demonstration storefront. No payment is collected and no order is sent."
        },
        {
          "question": "Can I explore different product options?",
          "answer": "Open a product to choose from its available variants. Your demo bag is saved in this browser."
        }
      ]
    },
    {
      "id": "banner",
      "type": "banner",
      "eyebrow": "A SOFTER GLOW",
      "title": "Make room\nfor a little warmth.",
      "description": "Beautiful lighting for quiet mornings and unhurried evenings.",
      "image": "images/lamp.svg",
      "cta": {
        "label": "Explore lighting",
        "href": "/catalog?category=lighting"
      },
      "enabled": false
    }
