  "storeId": "form-field-demo",
  "template": "home",
  "brand": {
    "name": "FORM & FIELD",
    "tagline": "Room to be yourself.",
    "description": "Thoughtful objects for the art of everyday living."
  },
  "theme": {
    "background": "#F8F5ED",
    "foreground": "#30372C",
    "accent": "#46513C",
    "accentText": "#FFFFFF",
    "surface": "#E9E6DC",
    "muted": "#646A5C",
    "headingFont": "Cormorant Garamond",
    "bodyFont": "DM Sans",
    "radius": 12,
    "contentWidth": 1200,
    "bodySize": 16,
    "buttonShape": "pill",
    "buttonStyle": "outline"
  },
  "presentation": {
    "header": {
      "sticky": true,
      "density": "compact",
      "showAnnouncement": false,
      "template": "fashion"
    },
    "footer": {
      "showLocale": false
    },
    "catalog": {
      "layout": "sidebar",
      "columns": 3,
      "mobileColumns": 1,
      "defaultSort": "price-low",
      "filters": {
        "brand": false
      }
    },
    "productCard": {
      "imageRatio": "square",
      "imageFit": "contain",
      "showCategory": false,
      "showBrand": true,
      "showOptions": false
    },
    "benefitsPosition": "hidden"
  }
