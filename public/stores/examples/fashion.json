  "storeId": "studio-form-demo",
  "template": "fashion",
  "brand": {
    "name": "STUDIO FORM",
    "tagline": "A considered wardrobe.",
    "description": "Less, but better. Pieces made for your everyday."
  },
  "theme": {
    "background": "#F9F7F3",
    "foreground": "#282620",
    "accent": "#453E35",
    "accentText": "#FFFFFF",
    "surface": "#EDE9E1",
    "muted": "#6C665C",
    "headingFont": "Cormorant Garamond",
    "bodyFont": "DM Sans",
    "radius": 0,
    "contentWidth": 1200,
    "bodySize": 16,
    "buttonShape": "square",
    "buttonStyle": "outline"
  },
  "presentation": {
    "header": {
      "sticky": true,
      "density": "compact",
      "showAnnouncement": false
    },
    "footer": {
      "showLocale": false
    },
    "catalog": {
      "layout": "sidebar",
      "columns": 2,
      "mobileColumns": 1,
      "defaultSort": "price-low",
      "filters": {
        "brand": false
      }
    },
    "productCard": {
      "imageRatio": "square",
      "imageFit": "contain",
      "showCategory": false,
      "showBrand": true,
      "showOptions": false
    },
    "benefitsPosition": "hidden"
  }
