  "storeId": "orbit-demo",
  "template": "electronics",
  "brand": {
    "name": "ORBIT",
    "tagline": "Technology, thoughtfully.",
    "description": "Considered technology. Extraordinary everyday."
  },
  "theme": {
    "background": "#FAFAF7",
    "foreground": "#202321",
    "accent": "#263FEC",
    "accentText": "#FFFFFF",
    "surface": "#F0F0EB",
    "muted": "#656963",
    "headingFont": "DM Sans",
    "bodyFont": "DM Sans",
    "radius": 4,
    "contentWidth": 1200,
    "bodySize": 16,
    "buttonShape": "pill",
    "buttonStyle": "outline"
  },
  "presentation": {
    "header": {
      "sticky": true,
      "density": "compact",
      "showAnnouncement": false
    },
    "footer": {
      "showLocale": false,
      "template": "fashion"
    },
    "catalog": {
      "layout": "toolbar",
      "columns": 3,
      "mobileColumns": 1,
      "defaultSort": "price-low",
      "filters": {
        "brand": false
      }
    },
    "productCard": {
      "imageRatio": "square",
      "imageFit": "contain",
      "showCategory": false,
      "showBrand": true,
      "showOptions": false
    },
    "benefitsPosition": "hidden"
  }
