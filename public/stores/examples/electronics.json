        "quickAdd": false
      },
      "cta": {
        "label": "Browse all pieces",
        "href": "/catalog"
      }
    },
    {
      "id": "our-approach",
      "type": "text",
      "layout": "split",
      "eyebrow": "THE IDEA",
      "title": "Made for your everyday.",
      "paragraphs": [
        "Considered technology. Extraordinary everyday.",
        "Explore the shapes, materials and details that bring this fictional collection together."
      ],
      "cta": {
        "label": "Read our story",
        "href": "/story"
      },
      "style": {
        "tone": "surface",
        "spacing": "airy"
      }
    },
    {
      "id": "our-promises",
      "type": "benefits",
      "style": {
        "spacing": "compact"
      }
    },
    {
      "id": "good-to-know",
      "type": "faq",
      "title": "A few helpful details.",
      "items": [
        {
          "question": "Can I place a real order here?",
          "answer": "This is a fictional demonstration storefront. No payment is collected and no order is sent."
        },
        {
          "question": "Can I explore different product options?",
          "answer": "Open a product to choose from its available variants. Your demo bag is saved in this browser."
        }
      ]
    },
    {
      "id": "banner",
      "type": "banner",
      "eyebrow": "SMALL SIZE. BIG ENERGY.",
      "title": "Good sound.\nAnywhere you go.",
      "description": "Your favorite moments deserve their own soundtrack. Take them with you.",
      "image": "images/speaker.svg",
      "cta": {
        "label": "Discover portable audio",
        "href": "/catalog?category=audio"
      },
      "enabled": false
    }
